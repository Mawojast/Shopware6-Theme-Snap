{
  "name": "Snap",
  "author": "Shopware AG",
  "views": [
     "@Storefront",
     "@Plugins",
     "@Snap"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/snap/snap.js"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "config": {
      "tabs": {
        "tabProductBox": {
          "label": {
            "en-GB": "Product Box",
            "de-DE": "Produkt Box"
          }
        }
      },
      "blocks": {
        "blockProductBoxBorder": {
          "label": {
            "en-GB": "Border",
            "de-DE": "Rahmen"
          }
        },
        "blockProductBoxTitle": {
          "label": {
            "en-GB": "Title",
            "de-DE": "Titel"
          }
        },
        "blockProductBoxPrice": {
          "label": {
            "en-GB": "Prices",
            "de-DE": "Preise"
          }
        },
        "blockProductBoxAddToShoppingCardButton": {
          "label": {
            "en-GB": "Add To Shopping Card Button",
            "de-DE": "In den Warenkorb Button"
          }
        }
      },
      "sections": {
        "section": {
          "label": {
            "en-GB": "Basic configuration",
            "de-DE": "Basiskonfiguration"
          }
        },
        "sectionProductBoxGeneral": {
          "label": {
            "en-GB": "Genral",
            "de-DE": "Allgemein"
          }
        },
        "sectionProductBoxBorderHover": {
          "label": {
            "en-GB": "Hover Effect",
            "de-DE": "Hover Effekt"
          }
        },
        "sectionProductBoxBorderMore": {
          "label": {
            "en-GB": "More",
            "de-DE": "Sonstiges"
          }
        },
        "sectionProductBoxVariantsFrom": {
          "label": {
            "en-GB": "Varaiants from price hint",
            "de-DE": "Varianten ab Preis Hinweis"
          }
        }
      },
      "fields": {
        "tsp-product-box-border-enabled": {
          "label": {
            "en-GB": "Show border",
            "de-DE": "Rahmen anzeigen"
          },
          "type": "switch",
          "value": true,
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxGeneral"
        },
        "tsp-product-box-border-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#dddddd",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxGeneral",
          "order": 100
        },
        "tsp-product-box-border-hover-enabled": {
          "label": {
            "en-GB": "Enable Hover Effect",
            "de-DE": "Hover anzeigen"
          },
          "type": "switch",
          "value": false,
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxBorderHover"
        },
        "tsp-product-box-border-hover-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#dddddd",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxBorderHover",
          "order": 100
        },
        "tsp-product-box-border-radius": {
          "label": {
            "en-GB": "Border radius",
            "de-DE": "Rundung"
          },
          "type": "text",
          "value": "0px",
          "custom": {
            "componentName": "sw-single-select",
            "options": [
              {
                "value": "0px"
              },
              {
                "value": "2px"
              },
              {
                "value": "4px"
              },
              {
                "value": "6px"
              },
              {
                "value": "8px"
              },
              {
                "value": "10px"
              },
              { 
                "value": "12px"
              },
              { 
                "value": "14px"
              },
              { 
                "value": "16px"
              },
              { 
                "value": "18px"
              },
              { 
                "value": "20px"
              }
            ]
          },
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxBorderMore"
        },
        "tsp-product-box-title-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#000000",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxTitle"
        },
        "tsp-product-box-price-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#000000",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxPrice",
          "order": 100
        },
        "tsp-product-box-show-cheapest-price": {
          "label": {
            "en-GB": "Show the cheapest price of variants",
            "de-DE": "Niedrigster Preis der Produkt-Varianten anzeigen"
          },
          "type": "switch",
          "value": false,
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxPrice",
          "section": "sectionProductBoxVariantsFrom"
        },
        "tsp-product-box-variants-from-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#000000",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxPrice",
          "section": "sectionProductBoxVariantsFrom",
          "order": 100
        },
        "tsp-product-box-add-to-shopping-card-button-background-color": {
          "label": {
            "en-GB": "Background Color",
            "de-DE": "Hintergrundfarbe"
          },
          "type": "color",
          "value": "#0042a0",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxAddToShoppingCardButton",
          "order": 100
        },
        "tsp-product-box-add-to-shopping-card-button-font-color": {
          "label": {
            "en-GB": "Font Color",
            "de-DE": "Schriftfarbe"
          },
          "type": "color",
          "value": "#ffffff",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxAddToShoppingCardButton",
          "order": 100
        },
        "tsp-product-box-add-to-shopping-card-border-radius": {
          "label": {
            "en-GB": "Border radius",
            "de-DE": "Rundung"
          },
          "type": "text",
          "value": "0px",
          "custom": {
            "componentName": "sw-single-select",
            "options": [
              {
                "value": "0px"
              },
              {
                "value": "2px"
              },
              {
                "value": "4px"
              },
              {
                "value": "6px"
              },
              {
                "value": "8px"
              },
              {
                "value": "10px"
              },
              { 
                "value": "12px"
              },
              { 
                "value": "14px"
              },
              { 
                "value": "16px"
              },
              { 
                "value": "18px"
              },
              { 
                "value": "20px"
              }
            ]
          },
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxAddToShoppingCardButton"
        },
        "tsp-product-box-add-to-shopping-card-height": {
          "label": {
            "de-DE": "Button Höhe",
            "en-GB": "Button height"
          },
          "type": "text",
          "value": "50px",
          "custom": {
              "componentName": "sw-single-select",
            "options": [
              {
                "value": "40px"
              },
              {
                "value": "45px"
              },
              {
                "value": "50px"
              },
              {
                "value": "55px"
              },
              {
                "value": "60px"
              },
              {
                "value": "65px"
              },
              { 
                "value": "70px"
              },
              { 
                "value": "75px"
              },
              { 
                "value": "80px"
              },
              {
                "value": "85px"
              },
              {
                "value": "90px"
              },
              {
                "value": "95px"
              },
              {
                "value": "100px"
              }
            ]
          },
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxAddToShoppingCardButton"
        }
      }
   }
}