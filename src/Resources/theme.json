{
  "name": "Snap",
  "author": "Shopware AG",
  "views": [
     "@Storefront",
     "@Plugins",
     "@Snap"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/snap/snap.js"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "iconSets": {
    "snapFooterIconSocial": "storefront/assets/icon/social"
  },
  "config": {
      "tabs": {
        "tabProductBox": {
          "label": {
            "en-GB": "Product Box",
            "de-DE": "Produkt Box"
          }
        },
        "tabFooter": {
          "label": {
            "en-GB": "Footer",
            "de-DE": "Fußzeile"
          }
        }
      },
      "blocks": {
        "blockProductBoxBorder": {
          "label": {
            "en-GB": "Border",
            "de-DE": "Rahmen"
          }
        },
        "blockProductBoxTitle": {
          "label": {
            "en-GB": "Title",
            "de-DE": "Titel"
          }
        },
        "blockProductBoxDescription": {
          "label": {
            "en-GB": "Description",
            "de-DE": "Beschreibung"
          }
        },
        "blockProductBoxPrice": {
          "label": {
            "en-GB": "Prices",
            "de-DE": "Preise"
          }
