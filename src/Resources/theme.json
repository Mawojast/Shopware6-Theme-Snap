{
  "name": "Snap",
  "author": "Shopware AG",
  "views": [
     "@Storefront",
     "@Plugins",
     "@Snap"
  ],
  "style": [
    "app/storefront/src/scss/overrides.scss",
    "@Storefront",
    "app/storefront/src/scss/base.scss"
  ],
  "script": [
    "@Storefront",
    "app/storefront/dist/storefront/js/snap/snap.js"
  ],
  "asset": [
    "@Storefront",
    "app/storefront/src/assets"
  ],
  "config": {
      "tabs": {
        "tabProductBox": {
          "label": {
            "en-GB": "Product Box",
            "de-DE": "Produkt Box"
          }
        }
      },
      "blocks": {
        "blockProductBoxBorder": {
          "label": {
            "en-GB": "Border",
            "de-DE": "Rahmen"
          }
        },
        "blockProductBoxTitle": {
          "label": {
            "en-GB": "Title",
            "de-DE": "Titel"
          }
        },
        "blockProductBoxCheapestPrice": {
          "label": {
            "en-GB": "Price",
            "de-DE": "Preis"
          }
        }
      },
      "sections": {
        "section": {
          "label": {
            "en-GB": "Basic configuration",
            "de-DE": "Basiskonfiguration"
          }
        },
        "sectionProductBoxGeneral": {
          "label": {
            "en-GB": "Genral",
            "de-DE": "Allgemein"
          }
        },
        "sectionProductBoxBorderHover": {
          "label": {
            "en-GB": "Hover Effect",
            "de-DE": "Hover Effekt"
          }
        },
        "sectionProductBoxBorderMore": {
          "label": {
            "en-GB": "More",
            "de-DE": "Sonstiges"
          }
        }
      },
      "fields": {
        "tsp-product-box-border-enabled": {
          "label": {
            "en-GB": "Show border",
            "de-DE": "Rahmen anzeigen"
          },
          "type": "switch",
          "value": true,
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxGeneral"
        },
        "tsp-product-box-border-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#dddddd",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxGeneral",
          "order": 100
        },
        "tsp-product-box-border-hover-enabled": {
          "label": {
            "en-GB": "Enable Hover Effect",
            "de-DE": "Hover anzeigen"
          },
          "type": "switch",
          "value": false,
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxBorderHover"
        },
        "tsp-product-box-border-hover-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#dddddd",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxBorderHover",
          "order": 100
        },
        "tsp-product-box-border-radius": {
          "label": {
            "en-GB": "Border radius",
            "de-DE": "Rundung"
          },
          "type": "text",
          "value": "0%",
          "custom": {
            "componentName": "sw-single-select",
            "options": [
              {
                "value": "0%"
              },
              {
                "value": "2%"
              },
              {
                "value": "4%"
              },
              {
                "value": "6%"
              },
              {
                "value": "8%"
              },
              {
                "value": "10%"
              }
            ]
          },
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxBorderMore"
        },
        "tsp-product-box-title-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#000000",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxTitle"
        },
        "tsp-product-box-show-cheapest-price": {
          "label": {
            "en-GB": "Show the cheapest price of variants",
            "de-DE": "Niedrigster Preis der Produkt-Varianten anzeigen"
          },
          "type": "switch",
          "value": false,
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxCheapestPrice"
        }
      }
   }
}