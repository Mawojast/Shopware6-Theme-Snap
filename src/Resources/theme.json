          "type": "switch",
          "value": true,
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxGeneral"
        },
        "tsp-product-box-border-color": {
          "label": {
            "en-GB": "Color",
            "de-DE": "Farbe"
          },
          "type": "color",
          "value": "#dddddd",
          "editable": true,
          "tab": "tabProductBox",
          "block": "blockProductBoxBorder",
          "section": "sectionProductBoxGeneral",
          "order": 100
